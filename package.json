{
  "name": "jsmkv",
  "version": "0.1.0",
  "description": "TypeScript tools for Matroska (MKV)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyf304/jsmkv.git"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./player": {
      "types": "./dist/esm/player/index.d.ts",
      "import": "./dist/esm/player/index.js",
      "require": "./dist/cjs/player/index.js"
    },
    "./remuxer": {
      "types": "./dist/esm/remuxer/index.d.ts",
      "import": "./dist/esm/remuxer/index.js",
      "require": "./dist/cjs/remuxer/index.js"
    }
  },
  "dependencies": {
    "lru-cache": "^10.2.2",
    "media-tracks": "^0.3.5"
  },
  "files": [ "dist" ],
  "devDependencies": {
    "@types/web": "^0.0.126",
    "bun-types": "latest",
    "npm": "^10.8.1",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "cli": "bun src/cli.ts",
    "build:demo": "bun src/demo/build.ts",
    "build:cjs": "tsc -p tsconfig.cjs.json && cp utils/cjs-package.json dist/cjs/package.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build": "rm -rf dist && bun run build:cjs && bun run build:esm && rm -f dist/*.tsbuildinfo",
    "npm:publish": "bun run build && npm publish --dry-run"
  },
  "type": "module"
}
